# Copy to .env.local and fill in values. Do not commit .env.local.

# MSB.io File API (presigned URL uploads) – used by chat file upload
NEXT_PUBLIC_FILE_API_URL=https://files.nbericmmsu.com
NEXT_PUBLIC_CDN_URL=https://cdn.nbericmmsu.com

# Same value as EXTERNAL_AUTH_APP_ID; required on client for file upload (appId for CDN URLs)
NEXT_PUBLIC_EXTERNAL_AUTH_APP_ID=10

# Optional: set to true to enable [FileUpload] / [TaskChat] console logs (e.g. in production)
# NEXT_PUBLIC_DEBUG_FILE_UPLOAD=true
